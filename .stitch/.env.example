# Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-service-account-key.json

# Doctors API (if using REST API source)
DOCTORS_API_URL=https://api.yourdomain.com
DOCTORS_API_TOKEN=your_api_token_here

# Lead Database (if using MySQL source)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vaidtrack
DB_USER=stitch_user
DB_PASSWORD=secure_password_here

# Google Stitch
STITCH_CLIENT_ID=your_stitch_client_id
STITCH_TOKEN=your_stitch_api_token
