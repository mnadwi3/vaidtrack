RewriteEngine On

# Redirect www → non-www (canonical domain)
RewriteCond %{HTTP_HOST} ^www\.vaidtrack\.com$ [NC]
RewriteRule ^(.*)$ https://vaidtrack.com/$1 [R=301,L]

# Redirect /index.html → /
RewriteRule ^index\.html$ / [R=301,L]

# Redirect *.html → clean URL (keep query string)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Home section clean URLs → serve homepage (URL stays /treatment, /doctors, etc.)
RewriteRule ^(treatment|doctors|testimonials|about-us|faq|contact|book-appointment|visa-travel|how-it-works)/?$ /index.html [L]

# Serve extensionless URLs as .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Treatment pages with no legacy static file → dynamic admin-panel page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html !-f
RewriteRule ^treatments/([a-zA-Z0-9-]+)/?$ /adminpanel/treatments/$1 [L]

# Specialty listing pages → dynamic admin-panel page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^specialities/([a-zA-Z0-9-]+)/?$ /adminpanel/specialities/$1 [L]

# Performance: compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Performance: long-cache immutable static assets (HTML stays short)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|webp|png|jpg|jpeg|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Security / best practices
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
